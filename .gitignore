```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.eggs/
*.egg-info/
.venv/
venv/
.env/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
jspm_packages/
*.module.js

# TypeScript
*.tsbuildinfo
*.bak

# General
.DS_Store
Thumbs.db
```