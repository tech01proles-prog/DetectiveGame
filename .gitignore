```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage
coverage/
htmlcov/
.coverage

# Distribution / packaging
.Python
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.mypy_cache/
.tox/
.nox/

# OS generated files
.DS_Store
Thumbs.db

# Compiled binary files
*.exe
*.dll
*.so
*.dylib

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
```