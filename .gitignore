```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.ts
*.tsx
*.jsx

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env
.env.local

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db

# Compiled and binary files
*.o
*.obj
*.out
*.exe
*.dll
*.so
*.a
*.class
```