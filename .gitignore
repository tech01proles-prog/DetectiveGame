```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python caches (if any Python files exist)
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Compression artifacts
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```