  "dialogueNodes": {
    "home_elena_1": {
      "id": "home_elena_1",
      "characterId": "elena",
      "title": "Разговор с Еленой",
      "eyebrow": "ПЕРВИЧНОЕ ПОКАЗАНИЕ",
      "intro": "Елена отвечает быстро, но каждое предложение будто заранее выучено. Она всё время поглядывает на телефон Майи.",
      "lines": [
        "«Она никогда не уходила так. Даже когда злилась, она писала мне».",
        "«Они что-то скрывают. Я чувствую это.»"
      ],
      "choices": [
        {
          "id": "route",
          "label": "Расспросить о маршруте домой",
          "text": "Елена описывает привычный путь Майи и упоминает конверт.",
          "clueIds": [
            "clue_01_phone"
          ]
        },
        {
          "id": "phone",
          "label": "Спросить о телефоне",
          "text": "Елена вспоминает, что телефон оставался дома уже в 20:51.",
          "clueIds": [
            "clue_01_phone"
          ]
        }
      ]
    },
    "school_daniel_1": {
      "id": "school_daniel_1",
      "characterId": "daniel",
      "title": "Допрос Дэниела Кроу",
      "eyebrow": "СВИДЕТЕЛЬ",
      "intro": "Дэниел держится спокойно. Он отвечает охотно, пока разговор не касается времени ухода Майи.",
      "lines": [
        "«Она была особенной ученицей. Всегда задавала правильные вопросы».",
        "«Я получил угрозы после того, как сказал полиции, что видел её в тот вечер.»"
      ],
      "choices": [
        {
          "id": "records",
          "label": "Показать журнал доступа",
          "text": "Когда вы показываете ему 20:07, Дэниел замолкает и вспоминает запасную карту.",
          "clueIds": [
            "clue_04_attendance"
          ]
        },
        {
          "id": "threat",
          "label": "Спросить об угрозах",
          "text": "Дэниел показывает письмо с предупреждением забыть то, что он видел.",
          "clueIds": [
            "clue_14_threat"
          ]
        }
      ]
    },
    "school_june_1": {
      "id": "school_june_1",
      "characterId": "june",
      "title": "Разговор с Джун",
      "eyebrow": "ОДНОКЛАССНИЦА",
      "intro": "Джун нервничает и несколько раз спрашивает, точно ли разговор не попадёт к её родителям.",
      "lines": [
        "«За ней следили. Я видела эту машину у её дома».",
        "«Она сказала, что нашла доказательство. Я решила, что она драматизирует.»"
      ],
      "choices": [
        {
          "id": "deleted",
          "label": "Спросить о скрытом сообщении",
          "text": "Джун всё-таки показывает сообщение, которое сначала удалила.",
          "clueIds": [
            "clue_08_chat"
          ]
        },
        {
          "id": "liapath",
          "label": "Почему Майя доверяла Лии?",
          "text": "Джун объясняет, что Лия уже помогала Майе проверять один старый снимок.",
          "clueIds": [
            "clue_08_chat"
          ]
        }
      ]
    },
    "lab_nora_1": {
      "id": "lab_nora_1",
      "characterId": "nora",
      "title": "Разговор с Норой",
      "eyebrow": "ФОТОЛАБОРАТОРИЯ",
      "intro": "Нора начинает разговор с защиты: она не хочет выглядеть человеком, который вмешивается в чужие дела.",
      "lines": [
        "«Я боялась. Они сказали, что если я заговорю, то пожалею».",
        "«Майя печатала фотографии грузов. Я не знала, что это опасно.»"
      ],
      "choices": [
        {
          "id": "receipt",
          "label": "Попросить показать внутренние записи",
          "text": "Нора достаёт квитанцию с номерами заказов RB-14.",
          "clueIds": [
            "clue_09_boxes"
          ]
        },
        {
          "id": "boxes",
          "label": "Спросить про RB-14",
          "text": "Нора подтверждает, что код встречался в заказах чаще обычного.",
          "clueIds": [
            "clue_09_boxes"
          ]
        }
      ]
    },
    "market_marcus_1": {
      "id": "market_marcus_1",
      "characterId": "marcus",
      "title": "Опрос Маркуса",
      "eyebrow": "СВИДЕТЕЛЬ",
      "intro": "Маркус избегает прямого взгляда. Он теребит ключи от фургона и постоянно оглядывается.",
      "lines": [
        "«Я просто водитель. Мне платят — я вожу.»",
        "«Да, видел фургон. Но номер? Не запомнил.»"
      ],
      "choices": [
        {
          "id": "van",
          "label": "Описать фургон",
          "text": "Маркус неохотно признаёт, что видел белый Ford Transit с треугольной наклейкой.",
          "clueIds": [
            "clue_03_van"
          ]
        },
        {
          "id": "money",
          "label": "Спросить про оплату",
          "text": "Маркус резко меняет тему. Подозрительно.",
          "clueIds": []
        }
      ]
    },
    "news_leah_1": {
      "id": "news_leah_1",
      "characterId": "leah",
      "title": "Разговор с Лией",
      "eyebrow": "ЖУРНАЛИСТКА",
      "intro": "Лия встречает вас в дверях редакции. У неё уставший вид, но глаза горят.",
      "lines": [
        "«Майя пришла ко мне две недели назад. У неё были фото.»",
        "«Я сказала ей быть осторожной. Видимо, недостаточно осторожно.»"
      ],
      "choices": [
        {
          "id": "photos",
          "label": "Что было на фото?",
          "text": "Лия показывает копии: грузовые контейнеры с маркировкой RB-14.",
          "clueIds": [
            "clue_07_manifest"
          ]
        },
        {
          "id": "envelope",
          "label": "Что в конверте?",
          "text": "Лия передаёт конверт с дополнительными материалами.",
          "clueIds": [
            "clue_10_news"
          ]
        }
      ]
    },
    "garage_sam_1": {
      "id": "garage_sam_1",
      "characterId": "sam",
      "title": "Допрос Сэма",
      "eyebrow": "ПОДОЗРЕВАЕМЫЙ",
      "intro": "Сэм выглядит загнанным. Его руки в масле, взгляд бегает по гаражу.",
      "lines": [
        "«Я ничего не сделал! Меня заставили.»",
